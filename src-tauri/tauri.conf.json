{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexora Clip",
  "version": "1.6.1",
  "identifier": "com.nexora.clip",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Nexora Clip",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost https: data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/fonts": "fonts",
      "resources/tunnel": "tunnel",
      "resources/models": "models",
      "resources/outro_logo.png": "outro_logo.png"
    },
    "license": "AGPL-3.0",
    "shortDescription": "AI video clipping",
    "longDescription": "Nexora Clip turns long videos into vertical short clips with AI clip selection, face-centered cropping and word-synced captions.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
